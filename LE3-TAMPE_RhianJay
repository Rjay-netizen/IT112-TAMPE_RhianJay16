#include <stdio.h>

int main() {
  char  name[50] ;
  char  section[15] ;
  int num1 ;
  int num2 ;

  printf("Enter your complete name: Tampe,RhianJay\n  ");
  fgets(name,  sizeof(name), stdin);

  printf("Enter your complete section: BSIT-1R13\n  ");
  fgets(section,  sizeof(section), stdin);

  printf("Enter first number: 2\n  ");
  scanf("%d" ,&num1);

  printf("Enter second number: 10\n  ");
  scanf("%d" ,&num2);

  int add = num1 + num2;
  int sub = num1 - num2;
  int mult = num1 * num2;
  float div = (float)num1 / num2;

  printf("\nStudent Calculator\n");
  printf("student name:%s\n" ,name);
  printf("section:%s\n" ,section);
  printf("     results: \n");

  printf("%d  +  %d  =%d\n" ,num1,num2,  add);
  printf("%d  -  %d  =%d\n" ,num1,num2,  sub);
  printf("%d  *  %d  =%d\n" ,num1,num2,  mult);
  printf("%d  /  %d  =%.2f\n" ,num1,num2,  div);

  return 0;
}
