#include <stdio.h>
#include <ctype.h>

int main(void)
{
    int n, i, largest;
    int arr[100];
    char str[200];
    int vowels = 0;

    /* ---------- Part 1: Largest Element in an Array ---------- */
    printf("Enter number of elements in the array: ");
    scanf("%d", &n);

    while (n <= 0 || n > 100)
    {
        printf("Invalid size. Enter number of elements (1-100): ");
        scanf("%d", &n);
    }

    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    largest = arr[0];
    for (i = 1; i < n; i++)
    {
        if (arr[i] > largest)
        {
            largest = arr[i];
        }
    }

    printf("The largest element in the array is: %d\n", largest);

    /* ---------- Part 2: Counting the Number of Vowels ---------- */
    while (getchar() != '\n'); /* clear leftover newline */

    printf("\nEnter a string: ");
    fgets(str, sizeof(str), stdin);

    for (i = 0; str[i] != '\0'; i++)
    {
        switch (tolower((unsigned char)str[i]))
        {
            case 'a':
            case 'e':
            case 'i':
            case 'o':
            case 'u':
                vowels++;
                break;
            default:
                break;
        }
    }

    printf("The number of vowels in the string is: %d\n", vowels);

    return 0;
}
